{
  "name": "papotato",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test",
    "setup:media": "node scripts/setup-media.mjs",
    "media": "node scripts/run-media.mjs",
    "test:media": "node --env-file-if-exists=.env scripts/test-media.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.0",
    "@livekit/components-styles": "^1.1.6",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "livekit-client": "^2.15.0",
    "livekit-server-sdk": "^2.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vite": "^7.1.0"
  }
}
