{
  "name": "papotato",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test",
    "setup:media": "node scripts/setup-media.mjs",
    "media": "node scripts/run-media.mjs",
    "test:media": "node --env-file-if-exists=.env scripts/test-media.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "electron desktop",
    "desktop:dist": "npm run desktop:build && electron-builder --config desktop/electron-builder.yml --win nsis --publish never",
    "test:firebase": "firebase emulators:exec --project demo-papotato --only firestore,auth \"node --test tests/firebase/*.test.js\"",
    "desktop:host:setup": "node --env-file=.env scripts/provision-host.mjs",
    "media:firebase": "node --env-file-if-exists=.env server/firebase-media.js"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.0",
    "@livekit/components-styles": "^1.1.6",
    "cookie": "^1.0.2",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase": "^13.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "livekit-client": "^2.15.0",
    "livekit-server-sdk": "^2.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@livekit/rtc-node": "^1.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
