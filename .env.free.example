# Set these only on the backend service in a card-free Railway Trial/Free account.
NODE_ENV=production
API_ONLY=true
DATA_DIR=/app/data
APP_ORIGIN=https://harleyzinn.github.io
APP_PUBLIC_URL=https://harleyzinn.github.io/papotato-web/
TRUST_PROXY=1
# LiveKit Cloud Build project (no card). Server-only values:
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=replace-on-the-server
LIVEKIT_API_SECRET=replace-on-the-server
# For root-owned Railway volumes only; bootstrap drops privileges before loading the app:
# RAILWAY_RUN_UID=0
